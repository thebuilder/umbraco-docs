{
  "name": "@thebuilder/umbraco-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @thebuilder/umbraco-docs build && node node_modules/@thebuilder/umbraco-docs/dist/og/cli.js && astro dev",
    "build": "pnpm --filter @thebuilder/umbraco-docs build && pnpm run build:site",
    "build:site": "node node_modules/@thebuilder/umbraco-docs/dist/og/cli.js && astro check && astro build",
    "check:og": "node node_modules/@thebuilder/umbraco-docs/dist/og/cli.js --check",
    "og:backdrop": "pnpm --filter @thebuilder/umbraco-docs build && node scripts/render-og-backdrop.ts"
  },
  "dependencies": {
    "@thebuilder/umbraco-docs": "workspace:*",
    "@vercel/analytics": "2.0.1",
    "astro": "7.3.2",
    "vgpu": "0.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "sharp": "0.35.3",
    "typescript": "^5.9.2"
  }
}
