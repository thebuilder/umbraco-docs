---
// The hero's WebGPU background. Without WebGPU the canvas stays transparent and the hero's CSS glow shows instead.
---

<canvas class="hub-hero-shader" aria-hidden="true" data-hub-hero-shader></canvas>

<script>
  import { startHeroShader } from "../hero/hero.ts";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hub-hero-shader]");
  if (canvas) startHeroShader(canvas, canvas.parentElement?.querySelector<HTMLElement>(".udocs-hero__inner") ?? undefined);
</script>
