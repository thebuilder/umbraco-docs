---
interface Props { id: string; title: string; description?: string; align?: "start" | "center"; }
const { id, title, description, align = "center" } = Astro.props;
---

<header class:list={["udocs-section-heading", `udocs-section-heading--${align}`]} data-udocs-reveal>
  <h2 id={id}>{title}</h2>
  {description && <p>{description}</p>}
</header>
