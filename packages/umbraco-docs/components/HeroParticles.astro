---
// The logo drawn in WebGPU particles behind a LandingHero's text. Put it in the hero's
// background slot. It needs the optional `vgpu` peer dependency; without WebGPU in the browser,
// the logo shows large and faded instead.
import type { HeroFlow } from "@thebuilder/umbraco-docs/hero";

interface Props {
  /** The logo to draw, usually the same image as the site's logo. */
  logo: string;
  /** A stroke of the logo whose particles stream along it instead of holding still. */
  flow?: HeroFlow;
}

const { logo, flow } = Astro.props;
---

<div class="udocs-particles" data-udocs-particles data-logo={logo} data-flow={flow ? JSON.stringify(flow) : undefined} aria-hidden="true">
  <img class="udocs-particles__fallback" src={logo} alt="" decoding="async" />
  <canvas class="udocs-particles__canvas"></canvas>
</div>

<script>
  import { startHeroParticles } from "@thebuilder/umbraco-docs/hero";

  const started = new WeakSet<HTMLElement>();

  const start = () => {
    for (const container of document.querySelectorAll<HTMLElement>("[data-udocs-particles]")) {
      if (started.has(container)) continue;
      started.add(container);
      const canvas = container.querySelector("canvas");
      const hero = container.parentElement;
      const logo = container.dataset.logo;
      if (!canvas || !hero || !logo) continue;
      const text = hero.querySelector<HTMLElement>(".udocs-hero__inner") ?? undefined;

      // Stop above whatever follows the text in the hero, such as a screenshot. Under a sticky
      // header, like Blume's, reach up behind it too, so the particles run on under the header
      // instead of ending in a line at its edge. Only the header: content above it stays clear.
      let lift = 0;
      // A sticky or fixed element before the hero whose bottom edge meets the hero's top. This
      // reads layout rather than hit-testing, which during a view transition (Blume's client-side
      // navigation) hits the transition's snapshot instead of the page.
      const coveringHeader = () => {
        const rect = hero.getBoundingClientRect();
        // Scrolled past the hero's top, the header no longer meets it; keep the last measurement.
        if (rect.top < 1) return lift;
        let covered = 0;
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_ELEMENT);
        for (let node = walker.nextNode() as Element | null; node && node !== hero; node = walker.nextNode() as Element | null) {
          if (node.contains(hero)) continue;
          const position = getComputedStyle(node).position;
          if (position !== "sticky" && position !== "fixed") continue;
          const box = node.getBoundingClientRect();
          if (box.height > 0 && Math.abs(box.bottom - rect.top) <= 1) covered = Math.max(covered, Math.round(rect.top - box.top));
        }
        return covered;
      };
      const fit = () => {
        let below = text?.nextElementSibling;
        while (below && ["SCRIPT", "STYLE", "TEMPLATE"].includes(below.tagName)) below = below.nextElementSibling;
        if (below instanceof HTMLElement) container.style.setProperty("--udocs-particles-height", `${below.offsetTop}px`);
        else container.style.removeProperty("--udocs-particles-height");
        lift = coveringHeader();
        hero.style.setProperty("--udocs-particles-lift", `${lift}px`);
        // The header goes clear at the top of the page only when the particles run behind it.
        document.documentElement.toggleAttribute("data-udocs-particles-header", lift > 0);
      };
      // Anything above the hero can move it too, such as a header changing height or a late banner.
      // Both observers report once right away, which does the first fit.
      const layout = new ResizeObserver(fit);
      layout.observe(hero);
      layout.observe(document.body);

      // Browsers without scroll-driven animations (landing.css) get the header's scroll state here.
      const scrollState = CSS.supports("animation-timeline: scroll()")
        ? undefined
        : () => document.documentElement.toggleAttribute("data-udocs-scrolled", window.scrollY > 8);
      if (scrollState) {
        scrollState();
        window.addEventListener("scroll", scrollState, { passive: true });
      }

      const stop = startHeroParticles(canvas, {
        logo,
        ...(container.dataset.flow ? { flow: JSON.parse(container.dataset.flow) } : {}),
        ...(text ? { text } : {}),
        pointerArea: hero,
        coveredTop: () => lift,
        onFallback: () => { container.dataset.fallback = "true"; },
      });
      document.addEventListener("astro:before-swap", () => {
        layout.disconnect();
        document.documentElement.removeAttribute("data-udocs-particles-header");
        if (scrollState) {
          window.removeEventListener("scroll", scrollState);
          document.documentElement.removeAttribute("data-udocs-scrolled");
        }
        stop();
      }, { once: true });
    }
  };

  start();
  document.addEventListener("astro:page-load", start);
</script>
