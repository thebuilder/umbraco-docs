---
interface Props {
  title: string;
  /** A short line above the title, such as what the package is for. */
  eyebrow?: string;
  description?: string;
  logo?: string;
  logoAlt?: string;
  accent?: string;
  compatibility?: string;
  /**
   * `centered` (the default) stacks everything in the middle. `split` puts the text on the left
   * and the logo, or a particle logo from the background slot, large on the right; on narrow
   * screens the logo sits above the text.
   */
  layout?: "centered" | "split";
}

const { title, eyebrow, description, logo, logoAlt = "", accent, compatibility, layout = "centered" } = Astro.props;
const split = layout === "split";
---

<section class="udocs-hero" data-layout={layout} aria-labelledby="udocs-hero-title">
  <slot name="background" />
  <div class="udocs-hero__glow" aria-hidden="true"></div>
  <div class="udocs-shell udocs-hero__inner">
    <div class="udocs-hero__copy">
      {logo && !split && <img class="udocs-hero__logo" src={logo} width="72" height="72" alt={logoAlt} data-udocs-reveal />}
      {eyebrow && <p class="udocs-hero__eyebrow" data-udocs-reveal>{eyebrow}</p>}
      <h1 id="udocs-hero-title" class="udocs-hero__title" data-udocs-reveal>
        {title}{accent && <> <span class="udocs-hero__accent">{accent}</span></>}
      </h1>
      {description && <p class="udocs-hero__description" data-udocs-reveal>{description}</p>}
      <div class="udocs-hero__actions" data-udocs-reveal><slot name="actions" /></div>
      <slot name="install" />
      {compatibility && <p class="udocs-hero__compatibility" data-udocs-reveal>{compatibility}</p>}
    </div>
    {/* Where the logo goes in the split layout. A particle logo forms here too. */}
    {split && (
      <div class="udocs-hero__art" data-udocs-hero-art>
        {logo && <img class="udocs-hero__art-logo" src={logo} alt={logoAlt} data-udocs-reveal />}
      </div>
    )}
  </div>
  <slot />
</section>
