---
import "../styles/landing.css";

interface Props { class?: string; }
const { class: className } = Astro.props;
---

<div class:list={["udocs-landing", className]} data-udocs-root>
  <slot />
</div>

<script>
  import { initializeUmbracoDocs } from "@thebuilder/umbraco-docs/behaviors";

  const initialize = () => initializeUmbracoDocs(document);
  initialize();
  document.addEventListener("astro:page-load", initialize);
</script>
