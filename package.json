{
  "name": "umbraco-docs-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm --filter @thebuilder/umbraco-docs build",
    "hub:dev": "pnpm --filter @thebuilder/umbraco-hub dev",
    "hub:build": "pnpm --filter @thebuilder/umbraco-hub build",
    "verify": "pnpm --filter @thebuilder/umbraco-docs verify && pnpm --filter @thebuilder/umbraco-hub build:site"
  }
}
