---
import type { UmbracoPackage } from "@thebuilder/umbraco-docs";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  packages: readonly UmbracoPackage[];
  currentPackageId?: string;
  title?: string;
  description?: string;
}

const {
  packages,
  currentPackageId,
  title = "More from TheBuilder",
  description = "Focused packages for modern Umbraco projects.",
} = Astro.props;
const visiblePackages = packages.filter((item) => item.id !== currentPackageId);
---

{visiblePackages.length > 0 && (
  <section class="udocs-shell udocs-ecosystem" aria-labelledby="udocs-ecosystem-title">
    <SectionHeading id="udocs-ecosystem-title" title={title} description={description} />
    <ul
      class:list={[
        "udocs-ecosystem__list",
        { "udocs-ecosystem__list--compact": visiblePackages.length <= 2 },
      ]}
      role="list"
    >
      {visiblePackages.map((item) => (
        <li class="udocs-ecosystem__item" data-udocs-reveal>
          <a class="udocs-ecosystem__card" href={item.links.docs} aria-label={`${item.name} documentation`}>
            <img src={item.logo} width="48" height="48" alt="" loading="lazy" />
            <div class="udocs-ecosystem__content">
              <div class="udocs-ecosystem__title">
                <h3>{item.name}</h3>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m13 6 6 6-6 6"></path>
                </svg>
              </div>
              <p>{item.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
