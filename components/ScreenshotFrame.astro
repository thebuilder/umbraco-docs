---
interface Props { src: string; alt: string; width: number; height: number; eager?: boolean; }
const { src, alt, width, height, eager = false } = Astro.props;
---

<figure class="udocs-screenshot" data-udocs-reveal>
  <div class="udocs-screenshot__bar" aria-hidden="true"><span></span><span></span><span></span></div>
  <img src={src} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} decoding="async" />
  <slot name="caption" />
</figure>
